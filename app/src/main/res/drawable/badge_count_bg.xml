<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#FF3B30"/> <!-- red badge -->

    <!-- Rounded corners (makes it pill/circle-like) -->
    <corners android:radius="12dp"/>

    <!-- Padding inside the badge -->
    <padding
        android:left="6dp"
        android:top="2dp"
        android:right="6dp"
        android:bottom="2dp"/>

</shape>