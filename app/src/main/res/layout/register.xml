<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="50dp">

        <ImageView
            android:id="@+id/loginImage"
            android:layout_width="329dp"
            android:layout_height="310dp"
            android:layout_marginTop="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/login" />

        <TextView
            android:id="@+id/loginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="Create your account here...."
            android:textColor="#020202"
            android:textSize="16sp" />

        <!-- Employee ID - Fixed size, not extendable -->
        <EditText
            android:id="@+id/employeeId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edittext_auth"
            android:hint="Employee ID"
            android:padding="15dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionNext" />

        <!-- Position - Fixed size, not extendable -->
        <EditText
            android:id="@+id/Position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edittext_auth"
            android:hint="Position"
            android:padding="15dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionNext" />

        <!-- Lastname - Fixed size, not extendable -->
        <EditText
            android:id="@+id/Lastname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edittext_auth"
            android:hint="Lastname"
            android:padding="15dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionNext" />

        <!-- Firstname - Fixed size, not extendable -->
        <EditText
            android:id="@+id/Firstname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edittext_auth"
            android:hint="Firstname"
            android:padding="15dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionNext" />

        <!-- Middlename - Fixed size, not extendable -->
        <EditText
            android:id="@+id/Middlename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edittext_auth"
            android:hint="Middle Initial"
            android:padding="15dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionNext" />

        <!-- Username - Fixed size, not extendable -->
        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edittext_auth"
            android:hint="Username"
            android:padding="15dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionNext" />

        <!-- Password row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_auth"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingTop="15dp"
                android:paddingEnd="50dp"
                android:paddingBottom="15dp"
                android:textSize="12sp"
                android:maxLines="1"
                android:singleLine="true"
                android:imeOptions="actionNext" />

            <ImageButton
                android:id="@+id/btnTogglePassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle password visibility"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/green0.2" />

        </FrameLayout>

        <!-- Confirm Password row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/Confirmpassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_auth"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingTop="15dp"
                android:paddingEnd="50dp"
                android:paddingBottom="15dp"
                android:textSize="12sp"
                android:maxLines="1"
                android:singleLine="true"
                android:imeOptions="actionDone" />

            <ImageButton
                android:id="@+id/btnTogglePassword1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle password visibility"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/green0.2" />

        </FrameLayout>

        <TextView
            android:id="@+id/Login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:letterSpacing="0.2"
            android:text="Login"
            android:textColor="#000000"
            android:textSize="18sp" />

        <Button
            android:id="@+id/RegisterBtn"
            android:layout_width="217dp"
            android:layout_height="55dp"
            android:background="@drawable/button_bg"
            android:letterSpacing="0.2"
            android:text="Register"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>